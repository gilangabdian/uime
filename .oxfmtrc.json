{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/dist/**",
    "**/storybook-static/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "pnpm-lock.yaml",
    "packages/ui/src/tokens/inject-styles.ts"
  ]
}
